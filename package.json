{
  "name": "postgres-dashboard",
  "version": "1.6.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "npm-run-all db-remote:neon db:migrate --parallel dev:*",
    "build:next": "next build --turbopack",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s build:next",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "commit": "commit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db-remote:neon": "npx get-db --yes --env .env.local --ref nextjs-boilerplate",
    "neon:claim": "npx get-db claim --env .env.local --ref nextjs-boilerplate",
    "db-server:file": "pglite-server --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "generate:password": "tsx scripts/generate-password.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@arcjet/next": "^1.9.1",
    "@hookform/resolvers": "^5.7.1",
    "@logtape/logtape": "^1.3.11",
    "@metabuilder/components": "file:../../libraries/components",
    "@metabuilder/dbal-sso": "file:../../libraries/redux/dbal-sso",
    "@metabuilder/hooks": "file:../../libraries/hooks",
    "@metabuilder/m3": "file:../../libraries/components/m3",
    "@metabuilder/redux-persist": "file:../../libraries/redux/persist",
    "@reduxjs/toolkit": "^2.11.2",
    "react-redux": "^9.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "pg": "^8.22.0",
    "posthog-js": "^1.414.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "minimatch": "10.2.4",
    "tar": "7.5.11",
    "hono": ">=4.12.4",
    "@hono/node-server": ">=1.19.10",
    "rollup": ">=4.59.0",
    "serialize-javascript": ">=7.0.3",
    "esbuild": ">=0.25.0",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react-hooks": {
      ".": "^7.0.1",
      "eslint": "$eslint"
    },
    "eslint-plugin-format": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@chromatic-com/playwright": "^0.14.11",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@faker-js/faker": "^10.5.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@sentry/nextjs": "^10.39.0",
    "@spotlightjs/spotlight": "4.11.8",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^6.9.10",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-format": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "get-db": "^0.14.0",
    "jest": "^30.2.0",
    "knip": "^5.88.1",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.2.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
